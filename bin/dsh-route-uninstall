#!/usr/bin/env bash
# dsh-route 卸载器 —— 安装时被放进 PATH（$BIN_DIR/dsh-route-uninstall），
# 读取安装清单（$PREFIX/MANIFEST）精确删除安装过的东西，不依赖发行包还在不在。
#
#   dsh-route-uninstall              停服务、删代码/客户端/服务定义/日志，保留配置与余额历史
#   dsh-route-uninstall --purge      连配置、API key、余额历史一起删
#   dsh-route-uninstall --dry-run    只打印会删什么
#
# 清单不可用时（比如代码目录被手工删了）退回到"按默认位置 + 平台探测"清理，并明确提示。
set -uo pipefail

# 安装时由 install.sh 把下面几个占位符替换成本次安装的实际路径，
# 所以每个安装都有自己的卸载器，不会找错清单、不会动到别人那份。
PREFIX_DEFAULT="@PREFIX@"
BIN_DIR_DEFAULT="@BIN_DIR@"
CONFIG_DIR_DEFAULT="@CONFIGDIR@"
STATE_DIR_DEFAULT="@STATEDIR@"
unsub() { case "$1" in *"@"*) printf '' ;; *) printf '%s' "$1" ;; esac; }

PREFIX="${DSH_ROUTE_PREFIX:-$(unsub "$PREFIX_DEFAULT")}"
[ -n "$PREFIX" ] || PREFIX="$HOME/.local/share/dsh-route"
MANIFEST="${DSH_ROUTE_MANIFEST:-$PREFIX/MANIFEST}"

PURGE=0; DRY=0
while [ $# -gt 0 ]; do
  case "$1" in
    --purge)   PURGE=1 ;;
    --dry-run) DRY=1 ;;
    -h|--help) sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "未知参数：$1（-h 看用法）" >&2; exit 2 ;;
  esac
  shift
done

say()  { printf '  %s\n' "$*"; }
step() { printf '\n▸ %s\n' "$*"; }
warn() { printf '  ! %s\n' "$*" >&2; }
die()  { printf '\n✗ %s\n' "$*" >&2; exit 1; }

# ── 读清单（安装时写的 key=value）────────────────────────────
have_manifest=0
if [ -f "$MANIFEST" ]; then
  have_manifest=1
  while IFS='=' read -r k v; do
    case "$k" in
      prefix)        PREFIX="${v:-$PREFIX}" ;;
      bin_dir)       BIN_DIR="$v" ;;
      client)        CLIENT="$v" ;;
      uninstaller)   UNINSTALLER="$v" ;;
      config_dir)    CONFIG_DIR="$v" ;;
      state_dir)     STATE_DIR="$v" ;;
      unit_file)     UNIT_FILE="$v" ;;
      unit_name)     UNIT_NAME="$v" ;;
      label)         LABEL="$v" ;;
      service_kind)  SERVICE_KIND="$v" ;;
      runtime_dir)   RUNTIME_DIR="$v" ;;
      log_file)      LOG_FILE="$v" ;;
      crontab_line)  CRONTAB_LINE="$v" ;;
      host_alias)    HOST_ALIAS="$v" ;;
      hosts_file)    HOSTS_FILE="$v" ;;
      hosts_applied) HOSTS_APPLIED="$v" ;;
      *) ;;
    esac
  done < "$MANIFEST"
fi

BIN_DIR="${BIN_DIR:-$(unsub "$BIN_DIR_DEFAULT")}"
[ -n "$BIN_DIR" ] || BIN_DIR="$HOME/bin"
CLIENT="${CLIENT:-$BIN_DIR/dsh-route}"
UNINSTALLER="${UNINSTALLER:-$BIN_DIR/dsh-route-uninstall}"
CONFIG_DIR="${CONFIG_DIR:-$(unsub "$CONFIG_DIR_DEFAULT")}"
[ -n "$CONFIG_DIR" ] || CONFIG_DIR="$HOME/.config/dsh-route"
STATE_DIR="${STATE_DIR:-$(unsub "$STATE_DIR_DEFAULT")}"
[ -n "$STATE_DIR" ] || STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/dsh-route"
UNIT_NAME="${UNIT_NAME:-dsh-route}"
LABEL="${LABEL:-com.dshroute.agent}"
SERVICE_KIND="${SERVICE_KIND:-}"
RUNTIME_DIR="${RUNTIME_DIR:-${XDG_RUNTIME_DIR:-/tmp}/dsh-route}"
LOG_FILE="${LOG_FILE:-}"

if [ "$have_manifest" = 1 ]; then
  step "卸载 dsh-route（按安装清单 ${MANIFEST}）"
else
  warn "找不到安装清单 $MANIFEST —— 退回按默认位置清理（代码目录被手工删过？）"
  step "卸载 dsh-route（无清单兜底）"
  UNIT_FILE=""
  if [ "$(uname -s)" = Darwin ]; then
    SERVICE_KIND="${SERVICE_KIND:-launchd}"
    UNIT_FILE="$HOME/Library/LaunchAgents/$LABEL.plist"
  elif systemctl --user show-environment >/dev/null 2>&1; then
    SERVICE_KIND="${SERVICE_KIND:-systemd}"
    UNIT_FILE="$HOME/.config/systemd/user/$UNIT_NAME.service"
  fi
fi

do_run() { if [ "$DRY" = 1 ]; then say "[dry-run] $*"; else "$@"; fi; }

# ── 安全删除：只删清单里记过的东西，拒绝危险路径 ─────────────
safe_rm() {
  p="$1"
  [ -n "${p:-}" ] || return 0
  case "$p" in
    /|"$HOME"|"$HOME"/) warn "拒绝删除受保护路径：$p"; return 1 ;;
  esac
  case "$p" in
    "$PREFIX"|"$PREFIX"/*|"$CONFIG_DIR"|"$CONFIG_DIR"/*|"$STATE_DIR"|"$STATE_DIR"/*|\
    "$BIN_DIR"/dsh-route|"$BIN_DIR"/dsh-route-uninstall|"$CLIENT"|"$UNINSTALLER"|\
    "$UNIT_FILE"|"$RUNTIME_DIR"|"$LOG_FILE") ;;
    *) warn "拒绝删除未登记的路径：$p"; return 1 ;;
  esac
  [ -e "$p" ] || [ -L "$p" ] || return 0
  if [ "$DRY" = 1 ]; then say "[dry-run] rm -rf $p"; else rm -rf -- "$p"; fi
}

# ── 1) 停服务（只停清单里记的那一份）─────────────────────────
stop_service() {
  case "$SERVICE_KIND" in
    systemd)
      if [ -n "${UNIT_FILE:-}" ] && grep -qF "$PREFIX" "$UNIT_FILE" 2>/dev/null; then
        if [ "$DRY" = 1 ]; then say "[dry-run] systemctl --user disable --now $UNIT_NAME"
        else systemctl --user disable --now "$UNIT_NAME" >/dev/null 2>&1 || true; fi
      fi ;;
    systemd-system)
      if [ -n "${UNIT_FILE:-}" ] && [ -f "$UNIT_FILE" ] && command -v sudo >/dev/null 2>&1; then
        if [ "$DRY" = 1 ]; then say "[dry-run] sudo systemctl disable --now $UNIT_NAME"
        else sudo systemctl disable --now "$UNIT_NAME" >/dev/null 2>&1 || true; fi
      fi ;;
    launchd)
      if [ -f "$HOME/Library/LaunchAgents/$LABEL.plist" ]; then
        if [ "$DRY" = 1 ]; then say "[dry-run] launchctl bootout gui/$(id -u)/$LABEL"
        else launchctl bootout "gui/$(id -u)/$LABEL" >/dev/null 2>&1 || true; fi
      fi ;;
    none|"")
      if [ -f "$STATE_DIR/dsh-route.pid" ]; then
        p=$(cat "$STATE_DIR/dsh-route.pid" 2>/dev/null || true)
        if [ -n "${p:-}" ] && ps -p "$p" -o command= 2>/dev/null | grep -qF "$PREFIX"; then
          do_run kill "$p" 2>/dev/null || true
        fi
      fi ;;
  esac
  # 兜底：按进程路径清掉本 prefix 的守护进程
  if pgrep -f "$PREFIX/daemon.py" >/dev/null 2>&1; then
    if [ "$DRY" = 1 ]; then say "[dry-run] pkill -f $PREFIX/daemon.py"
    else pkill -f "$PREFIX/daemon.py" 2>/dev/null || true; fi
  fi
  [ "$DRY" = 1 ] || sleep 1
}

echo
stop_service

# ── 2) 删文件 ────────────────────────────────────────────────
step "删除安装过的文件"
for p in "$UNIT_FILE" "${RUNTIME_DIR}" "${LOG_FILE}"; do
  [ -n "${p:-}" ] && safe_rm "$p"
done
# 安装时写进 /etc/hosts 的访问别名（只删自己带标记的那两行）
if [ "${HOSTS_APPLIED:-0}" = 1 ] && [ -n "${HOST_ALIAS:-}" ]; then
  hf="${HOSTS_FILE:-/etc/hosts}"
  if [ -f "$hf" ] && grep -qF "$HOST_ALIAS" "$hf" 2>/dev/null; then
    if [ "$DRY" = 1 ]; then
      say "[dry-run] 从 $hf 移除 $HOST_ALIAS"
    else
      htmp="$(mktemp)"
      grep -vF "# dsh-route" "$hf" > "$htmp" 2>/dev/null || cp "$hf" "$htmp" 2>/dev/null || : > "$htmp"
      if [ -w "$hf" ]; then
        cat "$htmp" > "$hf"; rm -f "$htmp"
        say "已从 $hf 移除访问别名 $HOST_ALIAS"
      elif sudo -n true 2>/dev/null; then
        sudo cp "$htmp" "$hf"; rm -f "$htmp"
        say "已从 $hf 移除访问别名 $HOST_ALIAS"
      else
        rm -f "$htmp"
        warn "没权限改 ${hf}：请手动删掉含 '# dsh-route' 的那两行"
      fi
    fi
  fi
fi
# 安装时可能残留的临时文件
if [ "$DRY" = 0 ]; then
  rm -f /tmp/dsh-route.service.* /tmp/dsh-route.sys.* /tmp/com.dshroute.agent.plist.* \
        /tmp/dsh-route.run.* /tmp/dsh-route-manifest.* 2>/dev/null || true
fi
if [ "$SERVICE_KIND" = systemd ] || [ "$SERVICE_KIND" = systemd-system ]; then
  [ "$SERVICE_KIND" = systemd ] && { [ "$DRY" = 1 ] || systemctl --user daemon-reload >/dev/null 2>&1 || true; }
  [ "$SERVICE_KIND" = systemd-system ] && [ "$DRY" = 0 ] && sudo systemctl daemon-reload >/dev/null 2>&1 || true
fi
# crontab 兜底自启
if [ -n "${CRONTAB_LINE:-}" ] && command -v crontab >/dev/null 2>&1; then
  if crontab -l 2>/dev/null | grep -qF "$PREFIX"; then
    if [ "$DRY" = 1 ]; then
      say "[dry-run] 清理 crontab 里的 dsh-route 行"
    else
      crontab -l 2>/dev/null | grep -vF "$PREFIX" | crontab - 2>/dev/null || true
      say "已清理 crontab 自启"
    fi
  fi
fi
safe_rm "$CLIENT"
safe_rm "$UNINSTALLER"
safe_rm "$PREFIX"
[ "$DRY" = 1 ] || say "已删除：服务定义、运行目录/日志、客户端、代码目录"

# ── 3) 配置与历史 ────────────────────────────────────────────
if [ "$PURGE" = 1 ]; then
  step "删除配置与历史"
  safe_rm "$CONFIG_DIR"
  safe_rm "$STATE_DIR"
fi

# ── 4) 自检 ──────────────────────────────────────────────────
if [ "$DRY" = 1 ]; then
  step "完成"
  say "（dry-run：没有改动任何文件，上面是将会执行的动作）"
  exit 0
fi
step "残留检查"
left=0
for p in "$PREFIX" "$CLIENT" "$UNINSTALLER" "${UNIT_FILE:-}" "${RUNTIME_DIR:-}" "${LOG_FILE:-}"; do
  [ -n "${p:-}" ] || continue
  if [ -e "$p" ] || [ -L "$p" ]; then say "! 残留：$p"; left=$((left + 1)); fi
done
if pgrep -f "$PREFIX/daemon.py" >/dev/null 2>&1; then
  say "! 残留：仍有进程 $(pgrep -f "$PREFIX/daemon.py" | tr '\n' ' ')"; left=$((left + 1))
fi
if [ -n "${LABEL:-}" ] && command -v launchctl >/dev/null 2>&1 && launchctl list 2>/dev/null | grep -q "$LABEL"; then
  say "! 残留：launchd 里仍注册着 $LABEL"; left=$((left + 1))
fi
if [ "$DRY" = 0 ]; then
  [ "$left" = 0 ] && say "干净：安装过的东西已全部移除" || warn "有 $left 处残留（见上）"
  if [ "$PURGE" = 1 ]; then
    say "配置与历史已删除"
  else
    say "保留（要删就加 --purge）："
    [ -d "$CONFIG_DIR" ] && say "  $CONFIG_DIR"
    [ -d "$STATE_DIR" ] && say "  $STATE_DIR"
  fi
else
  say "（dry-run，未改动任何文件）"
fi
